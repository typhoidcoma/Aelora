{
  "name": "aelora",
  "version": "0.1.0",
  "description": "LLM-powered Discord bot with persona system, tools, agents, and web dashboard",
  "author": "Tyler Paul Esselstrom",
  "license": "MIT",
  "keywords": [
    "discord",
    "bot",
    "llm",
    "ai",
    "openai",
    "persona"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/boot.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/boot.js",
    "lint": "tsc --noEmit",
    "test": "tsx src/persona-llm.test.ts && tsx src/tool-architecture.test.ts && tsx src/llm-runtime.test.ts",
    "check": "npm run build && npm run lint && npm run test"
  },
  "dependencies": {
    "@linear/sdk": "^76.0.0",
    "@supabase/supabase-js": "^2.49.4",
    "chrono-node": "^2.9.0",
    "croner": "^10.0.1",
    "discord.js": "^14.18.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "openai": "^4.77.0",
    "pdf-parse": "^2.4.5",
    "vectra": "^0.12.3",
    "ws": "^8.19.0",
    "yaml": "^2.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
